@model RaceDay.MVC.Models.Users
@{
    ViewData["Title"] = "My Profile";
    var name = Context.Session.GetString("Name") ?? "";
    var email = Context.Session.GetString("Email") ?? "";
    var role = Context.Session.GetString("Role") ?? "";
    var userId = Context.Session.GetString("UserId") ?? "";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white text-center py-4">
                    <div style="font-size: 60px;">👤</div>
                    <h3 class="mb-0 mt-2">My Profile</h3>
                    <p class="mb-0 opacity-75">RaceDay.MVC</p>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3 p-3 bg-light rounded-3">
                        <small class="text-muted text-uppercase fw-bold">Full Name</small>
                        <h5 class="mb-0 mt-1">@name</h5>
                    </div>
                    <div class="mb-3 p-3 bg-light rounded-3">
                        <small class="text-muted text-uppercase fw-bold">Email</small>
                        <h5 class="mb-0 mt-1">@email</h5>
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <div class="p-3 bg-light rounded-3 text-center">
                                <small class="text-muted text-uppercase fw-bold">Role</small>
                                <div><span class="badge bg-success fs-6 mt-1 text-capitalize">@role</span></div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 bg-light rounded-3 text-center">
                                <small class="text-muted text-uppercase fw-bold">User ID</small>
                                <h5 class="mb-0 mt-1">#@userId</h5>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-white border-0 pb-4 px-4 d-flex gap-2">
                    <a href="/Participant/Index" class="btn btn-primary flex-fill">Browse Events</a>
                    <a href="/Organiser/Dashboard" class="btn btn-outline-primary flex-fill">Dashboard</a>
                </div>
            </div>
        </div>
    </div>
</div>
