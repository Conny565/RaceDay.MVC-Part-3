@model List<RaceDay.MVC.Models.Result>
<h2>My Results</h2>
@if (!Model.Any())
{
    <p>No results yet.</p>
}
<table class="table">
    <tr><th>Event</th><th>Finish Time</th><th>Position</th></tr>
    @foreach (var r in Model)
    {
        <tr><td>@r.EventName</td><td>@r.FinishTime</td><td>@r.Position</td></tr>
    }
</table>
