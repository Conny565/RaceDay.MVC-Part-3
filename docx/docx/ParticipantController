using Microsoft.AspNetCore.Mvc;
using RaceDay.MVC.Models;
using RaceDay.MVC.Services;
using System.Text.Json;

namespace RaceDay.MVC.Controllers
{
    public class ParticipantController : Controller
    {
        private readonly ApiService _api;

        public ParticipantController(ApiService api)
        {
            _api = api;
        }

        private bool IsParticipant()
        {
            var role = HttpContext.Session.GetString("UserRole");
            return !string.IsNullOrEmpty(HttpContext.Session.GetString("UserId"))
                   && (role == "participant" || role == "Participant");
        }

        private int GetUserId()
        {
            int.TryParse(HttpContext.Session.GetString("UserId"), out int id);
            return id;
        }

        // 1. BROWSE EVENTS - /Participant/Index
        public async Task<IActionResult> Index()
        {
            if (!IsParticipant() && string.IsNullOrEmpty(HttpContext.Session.GetString("UserId")))
                return RedirectToAction("Login", "Account");

            var eventsList = await _api.GetAllEventsAsync();
            return View(eventsList ?? new List<events>());
        }

        // 2. EVENT DETAIL + ENTER BUTTON - /Participant/Details/5
        public async Task<IActionResult> Details(int id)
        {
            if (string.IsNullOrEmpty(HttpContext.Session.GetString("UserId")))
                return RedirectToAction("Login", "Account");

            var ev = await _api.GetEventByIdAsync(id);
            if (ev == null) return NotFound();
            return View(ev);
        }

        // 3. ENTER EVENT - POST
        [HttpPost]
        public async Task<IActionResult> Enter(int eventId)
        {
            if (string.IsNullOrEmpty(HttpContext.Session.GetString("UserId")))
                return RedirectToAction("Login", "Account");

            bool ok = await _api.EnterEventAsync(eventId, GetUserId());
            if (ok)
                TempData["Success"] = "You have entered the event!";
            else
                TempData["Error"] = "Could not enter event. Maybe you already entered?";

            return RedirectToAction("MyEvents");
        }

        // 4. MY EVENTS
        public async Task<IActionResult> MyEvents()
        {
            if (string.IsNullOrEmpty(HttpContext.Session.GetString("UserId")))
                return RedirectToAction("Login", "Account");

            var myEvents = await _api.GetMyEventsAsync(GetUserId());
            return View(myEvents ?? new List<events>());
        }

        // 5. MY RESULTS - with finish time + position
        public async Task<IActionResult> MyResults()
        {
            if (string.IsNullOrEmpty(HttpContext.Session.GetString("UserId")))
                return RedirectToAction("Login", "Account");

            var results = await _api.GetMyResultsAsync(GetUserId());
            return View(results);
        }

        // 6. MY PROFILE
        public async Task<IActionResult> Profile()
        {
            if (string.IsNullOrEmpty(HttpContext.Session.GetString("UserId")))
                return RedirectToAction("Login", "Account");

            var user = await _api.GetUserByIdAsync(GetUserId());
            return View(user);
        }
    }
}
